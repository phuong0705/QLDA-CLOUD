# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQL Server)
DB_USER=sa
DB_PASSWORD=your_database_password_here
DB_SERVER=localhost
DB_NAME=XiangqiDB
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Configuration (Stateless Authentication)
# Lưu ý: Không lưu secret thật vào file này hoặc commit secret lên Git
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRES_IN=24h
